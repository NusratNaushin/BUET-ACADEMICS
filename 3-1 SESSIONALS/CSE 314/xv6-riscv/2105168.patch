+int history(int id, uint64 ustats)
+{
+
+  return copyout(myproc()->pagetable, (uint64)ustats , (char *)&syscall_stats[id] , sizeof(struct syscall_stat)); 
+
+}
+
+int settickets(int tickets){
+
+  struct proc*p = myproc();
+
+  if(tickets < 1){
+    p->tickets_original = DEFAULT_TICKET_COUNT;
+    p->tickets_current = DEFAULT_TICKET_COUNT;
+
+    return -1;
+  }
+  else{
+     p->tickets_original = tickets;
+    p->tickets_current = tickets;
+  }
+
+  return 0;
+}
+
+int getpinfo(struct pstat *process_characteristics){
+    struct proc *p;
+    for(int i = 0; i < NPROC ; i++){
+      p = &proc[i];
+      if(p->state != UNUSED){
+          process_characteristics->inuse[i] = 1;
+           process_characteristics->pid[i] = p->pid;
+      process_characteristics->inQ[i] = p->inQ;
+
+      process_characteristics->tickets_original[i] = p->tickets_original;
+      process_characteristics->tickets_current[i] = p->tickets_current;
+      process_characteristics->time_slices[i] = p->time_slices;
+      }
+      else{
+        process_characteristics->inuse[i] = 0;
+      }
+     
+    }
+
+
+
+    
+
+    return 0;
+}
