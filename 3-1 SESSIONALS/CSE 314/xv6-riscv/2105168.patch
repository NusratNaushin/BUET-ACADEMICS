diff --git a/kernel/random.h b/kernel/random.h
new file mode 100644
index 0000000..52e58c0
--- /dev/null
+++ b/kernel/random.h
@@ -0,0 +1,19 @@
+//https://en.wikipedia.org/wiki/Xorshift
+#ifndef RAND_H
+#define RAND_H
+#include "types.h"
+
+uint64 SEED = 782003;
+
+int rng(int n){
+    uint64 x = SEED;
+    x ^= x << 13;
+    x ^= x >> 17;
+    x ^= x << 5;
+
+    SEED = x;
+
+    return 1 + x%n;
+}
+
+#endif 
