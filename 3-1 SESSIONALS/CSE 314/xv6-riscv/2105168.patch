+                 printf("%d: syscall %s,# : %d ,time : %d \n",i, st.syscall_name,st.count,st.accum_time);
+
+            }
+            
+        }
+        
+    }
+    else{
+            id = atoi(argv[1]);
+
+            history(id, &st);
+            printf("%d: syscall %s,# : %d ,time : %d ",id,st.syscall_name,st.count,st.accum_time);
+    }
+
+    return 0;
+}
